# Form handling — every form on the site posts to /api/enquiry, which emails the
# answers. Copy to .env.local for development, and set the same three in the
# Vercel project (Settings → Environment Variables) for production.
#
# Without RESEND_API_KEY the endpoint returns 503 and the form tells the visitor
# to call instead, keeping their answers on screen. It never silently discards an
# enquiry.

# 1. Sign up at resend.com and verify onlinemarketinghelp.co.uk as a sending
#    domain (adds a few DNS records). Then create an API key.
RESEND_API_KEY=

# 2. Where enquiries land. Defaults to support@onlinemarketinghelp.co.uk.
ENQUIRY_TO=support@onlinemarketinghelp.co.uk

# 3. The From address. Must be on the verified domain or Resend rejects the send.
ENQUIRY_FROM=Website enquiries <enquiries@onlinemarketinghelp.co.uk>
