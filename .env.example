# Sanity — copy to .env.local for local development, and set the same two
# variables in the Vercel project (Production and Preview).
#
# The dataset is public, so reads need no token and none is required to build.
NEXT_PUBLIC_SANITY_PROJECT_ID=8wl45ar9
NEXT_PUBLIC_SANITY_DATASET=production

# Shared secret for the publish webhook (Sanity -> /api/revalidate).
# Invent any long random string; paste the same value into the webhook's
# Secret field in sanity.io/manage. Without it the endpoint rejects requests.
SANITY_REVALIDATE_SECRET=

# Contact / quote form delivery (app/api/enquiry), sent via Hostinger business
# email over SMTP. Without SMTP_USER and SMTP_PASS the route logs and returns
# gracefully instead of sending, so forms appear to work but no email arrives —
# set them in Vercel for Production.
SMTP_USER=
SMTP_PASS=
# Optional. Default to smtp.hostinger.com on 465 (implicit TLS); 587 uses STARTTLS.
SMTP_HOST=
SMTP_PORT=
# Optional overrides. ENQUIRY_TO falls back to support@onlinemarketinghelp.co.uk,
# ENQUIRY_FROM to the SMTP_USER mailbox. Hostinger only permits sending as a
# mailbox you own, so a custom ENQUIRY_FROM must be on that domain.
ENQUIRY_TO=
ENQUIRY_FROM=

# VPS deploy only (docker-compose.yml reads these from .env on the server).
# TRAEFIK_NETWORK is the docker network the existing Traefik/n8n stack created —
# find it with: docker inspect -f '{{range $k,$v := .NetworkSettings.Networks}}{{$k}}{{end}}' <traefik-container>
DOMAIN=onlinemarketinghelp.co.uk
TRAEFIK_NETWORK=n8n_default
