# Sanity — copy to .env.local for local development, and set the same two
# variables in the Vercel project (Production and Preview).
#
# The dataset is public, so reads need no token and none is required to build.
NEXT_PUBLIC_SANITY_PROJECT_ID=8wl45ar9
NEXT_PUBLIC_SANITY_DATASET=production

# Shared secret for the publish webhook (Sanity -> /api/revalidate).
# Invent any long random string; paste the same value into the webhook's
# Secret field in sanity.io/manage. Without it the endpoint rejects requests.
SANITY_REVALIDATE_SECRET=
