# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
# the standalone Studio manages its own dependencies
studio/node_modules
studio/dist
studio/.sanity
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the template documents what to set, so it belongs in the repo
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
